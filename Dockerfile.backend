FROM ros:humble

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    libpq-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies via uv to avoid legacy pip backtracking
COPY requirements.txt .
RUN pip install --no-cache-dir uv && uv pip install --system --no-cache -r requirements.txt
# Since we are running edge services too, let's install the edge requirements
RUN uv pip install --system --no-cache torch torchvision --index-url https://download.pytorch.org/whl/cpu
RUN uv pip install --system --no-cache opencv-python-headless ultralytics mavsdk git+https://github.com/ultralytics/CLIP.git

# Copy application source
COPY src/ ./src/

# Make sure PYTHONPATH includes src
ENV PYTHONPATH=/app/src:/app

# Default command for the backend API
CMD ["bash", "-c", "source /opt/ros/humble/setup.bash && uvicorn src.uservice.main:app --host 0.0.0.0 --port 8000"]
