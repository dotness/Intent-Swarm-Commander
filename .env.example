# Google AI / Gemini API Configuration
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash-lite
GEMINI_COPILOT_MODEL=gemini-2.5-flash-lite

# Backend Configuration
DATABASE_URL=postgresql+asyncpg://isc_user:isc_pass@localhost:5432/isc_db
TEMPORAL_URL=localhost:7233
ISC_TASK_QUEUE=isc-smeac-queue
PMDL_TASK_QUEUE=pmdl-ingestion-queue

# PMDL C4ISR Infrastructure
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MEMGRAPH_BOLT_URI=bolt://localhost:7687

# PMDL Mission & Edge Configuration
DEFAULT_PROJECT_ID=default-theater
PARQUET_FLUSH_INTERVAL_S=10
CORRELATION_RADIUS_M=150.0
CORRELATION_WINDOW_S=60.0
EDGE_SPOOL_DB_PATH=/tmp/isc_edge_spool.db
